{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EDINET: Start server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--no-reload"],
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Install project requirements"
    }
  ]
}
